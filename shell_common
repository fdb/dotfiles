# Common shell configuration for bash and zsh
# Source this file from both .bashrc and .zshrc

# Git aliases
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gb='git branch'
alias gco='git checkout'
alias gc='git commit'
alias gca='git commit --amend'
alias gcm='git commit -m'
# One-line graph log; show the committer name only when it is not me.
function gl() {
  git log --color=always --graph --pretty=format:'%C(auto)%h%d %s%C(dim) (%cn)%C(reset)' "$@" \
    | sed "s/ ($(git config user.name))//" \
    | less -RFX
}
alias gd='git diff'
alias gdc='git diff --cached'
alias gf='git fetch'
alias gpush='git push'
alias gp='git pull'
alias gss='git stash'
alias gsp='git stash pop'
# Delete merged branches. Skip the ones a worktree has checked out (marked "+").
alias gdmb='git branch --merged | grep -Ev "(^[*+]|master|main|dev)" | xargs git branch -d'

# Git plumbing primitives — shared between bash and zsh prompts.
function git_current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null
}

function git_is_dirty() {
  ! { git diff --quiet HEAD -- 2>/dev/null && git diff --cached --quiet HEAD -- 2>/dev/null; }
}

# Git worktree helpers — worktrees live in ~/.worktrees/<repo>/<branch>
function _git_main_root() {
  local common_dir
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { echo "Not in a git repo" >&2; return 1; }
  echo "${common_dir%/.git}"
}

function _git_worktree_base() {
  local root
  root=$(_git_main_root) || return 1
  echo "$HOME/.worktrees/${root##*/}"
}

function gwt() {
  if [ -z "${1:-}" ]; then
    git worktree list
    return
  fi
  local name="$1"
  local base
  base=$(_git_worktree_base) || return 1
  local wt_dir="$base/$name"
  if [ -d "$wt_dir" ]; then
    cd "$wt_dir"
  elif git show-ref --verify --quiet "refs/heads/$name"; then
    # Local branch exists — check it out in a worktree
    git worktree add "$wt_dir" "$name" && cd "$wt_dir"
  elif git show-ref --verify --quiet "refs/remotes/origin/$name"; then
    # Remote branch exists — create tracking worktree
    git fetch origin "$name" && git worktree add "$wt_dir" "$name" && cd "$wt_dir"
  else
    # No existing branch — create a new one
    git worktree add "$wt_dir" -b "$name" && cd "$wt_dir"
  fi
}

function gwtrm() {
  local root wt_dir
  root=$(_git_main_root) || return 1

  if [ -n "${1:-}" ]; then
    local base
    base=$(_git_worktree_base) || return 1
    wt_dir="$base/$1"
  else
    wt_dir=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ "$wt_dir" = "$root" ]; then
      echo "Not in a worktree. Usage: gwtrm [branch-name]" >&2
      return 1
    fi
  fi

  # git refuses to remove a worktree with uncommitted or untracked files.
  cd "$root" && git worktree remove "$wt_dir" || return 1
  # Drop the per-repo directory once its last worktree is gone.
  rmdir "${wt_dir%/*}" 2>/dev/null || true
}

# Claude alias
alias cc='claude --permission-mode auto'
alias ccc='claude --dangerously-skip-permissions'

# Directory navigation
alias ..="cd .."
alias ...="cd ../.."
alias duh='du -h -d 1 | sort -h'

# Rust aliases
alias cr='cargo run'
alias ct='cargo test'

# Set terminal colors
export TERM=xterm-256color

# Cheat sheet lookup
function cheat() { curl cheat.sh/$1; }

# Navigate up N directories
function up() { cd $(eval printf '../'%.0s {1..$1}); }

# macOS: Navigate to Finder window
if [[ "$OSTYPE" == darwin* ]]; then
    ff() {
        osascript -e 'tell application "Finder"' \
        -e "if (${1-1} <= (count Finder windows)) then" \
        -e "get POSIX path of (target of window ${1-1} as alias)" \
        -e 'else' -e 'get POSIX path of (desktop as alias)' \
        -e 'end if' -e 'end tell'
    }
    cdff() { cd "$(ff "$@")"; }
fi
